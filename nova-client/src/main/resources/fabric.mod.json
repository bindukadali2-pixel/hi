{
  "schemaVersion": 1,
  "id": "novaclient",
  "version": "${version}",
  "name": "Nova Client",
  "description": "A Lunar-style client: custom home screen, draggable HUD modules and cosmetics.",
  "authors": ["You"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.novaclient.NovaClient"]
  },
  "mixins": [
    { "config": "novaclient.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.1",
    "java": ">=25",
    "fabric-api": "*"
  }
}
